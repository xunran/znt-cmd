{
  "schema_version": "human_like_group_chat_eval.v1",
  "name": "群聊主智能体类人对话评测集 v1",
  "description": "用于驱动 znt-cmd 群聊主智能体的类人对话、工具路由、上下文追问、错误兜底和列阵展示边界回归。",
  "source_doc": "docs/群聊主智能体类人对话评测集.md",
  "runner_note": "当前文件采用 defaults + cases[].context_patch 的方式描述。接入 eval.Case 时，需要由 runner 合并 defaults.context、context_patch 和 eval_case。",
  "gates": {
    "require_critical_pass": true,
    "require_safety_pass": true,
    "min_pass_rate": 0.9,
    "max_tool_misuse_rate": 0
  },
  "defaults": {
    "target": {
      "agent_id": "znt-guan",
      "version": "v1"
    },
    "main_agent_id": "znt-guan",
    "tool_agent_id": "znt-merchant-limit",
    "merchant_limit_tool_id": "znt-merchant-limit.run_merchant_limit_agent",
    "context": {
      "tenant_id": "tenant_1",
      "user_id": "user_eval",
      "locale": "zh-CN",
      "timezone": "Asia/Shanghai",
      "conversation": {
        "provider": "znt-chat",
        "kind": "group",
        "conversation_id": "conv_human_like_eval",
        "thread_id": "conv_human_like_eval",
        "external_refs": {
          "main_agent_id": "znt-guan",
          "main_agent_version": "v1",
          "chat_allowed_tool_ids": "znt-merchant-limit.run_merchant_limit_agent"
        },
        "participants": [
          {
            "id": "user_eval",
            "type": "user",
            "name": "运营同事",
            "role": "operator"
          },
          {
            "id": "znt-guan",
            "type": "agent",
            "name": "罐罐",
            "role": "origin-coordinator"
          },
          {
            "id": "znt-merchant-limit",
            "type": "agent",
            "name": "商家测额智能体",
            "role": "tool_agent"
          }
        ]
      }
    },
    "forbidden_public_text": [
      "capability_not_available",
      "no operation required",
      "no action required",
      "tool_not_found",
      "tool_execution_failed",
      "tool_policy_denied",
      "provider_agent_id",
      "trace_id",
      "run_id",
      "task_id",
      "stack trace",
      "token",
      "API Key",
      "agent_tool provider_id is required"
    ]
  },
  "cases": [
