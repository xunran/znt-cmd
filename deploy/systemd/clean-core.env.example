CLEAN_CORE_ENV=production
CLEAN_CORE_HTTP_ADDR=:8080
CLEAN_CORE_LOG_LEVEL=info
CLEAN_CORE_SERVICE_TOKEN=REPLACE_WITH_STRONG_SERVICE_TOKEN

CLEAN_CORE_DATABASE_URL=postgres://clean_core:REPLACE_WITH_PASSWORD@127.0.0.1:5432/clean_core?sslmode=disable
CLEAN_CORE_READINESS_MODE=deep
CLEAN_CORE_DB_MAX_OPEN_CONNS=25
CLEAN_CORE_DB_MAX_IDLE_CONNS=10
CLEAN_CORE_DB_CONN_MAX_LIFETIME_SECONDS=1800
CLEAN_CORE_DB_CONN_MAX_IDLE_TIME_SECONDS=300

CLEAN_CORE_HTTP_READ_HEADER_TIMEOUT_SECONDS=5
CLEAN_CORE_HTTP_READ_TIMEOUT_SECONDS=30
CLEAN_CORE_HTTP_WRITE_TIMEOUT_SECONDS=300
CLEAN_CORE_HTTP_IDLE_TIMEOUT_SECONDS=120
CLEAN_CORE_HTTP_MAX_BODY_BYTES=4194304

CLEAN_CORE_RUN_MAX_CONCURRENT=100
CLEAN_CORE_TENANT_RUN_MAX_CONCURRENT=50
CLEAN_CORE_AGENT_RUN_MAX_CONCURRENT=20
CLEAN_CORE_AGENT_RUN_EXECUTION_MODE=async

CLEAN_CORE_MODEL_PROVIDER=openai-compatible
CLEAN_CORE_MODEL_BASE_URL=https://api.deepseek.com
CLEAN_CORE_MODEL_API_KEY=REPLACE_WITH_MODEL_API_KEY
CLEAN_CORE_MODEL_NAME=REPLACE_WITH_MODEL_NAME
CLEAN_CORE_MODEL_MAX_TOKENS=2048
CLEAN_CORE_MODEL_TEMPERATURE=0
CLEAN_CORE_MODEL_THINKING=disabled
CLEAN_CORE_MODEL_REASONING_EFFORT=

CLEAN_CORE_CONVERSATION_JUDGE_MODE=hybrid
CLEAN_CORE_CONVERSATION_JUDGE_TIMEOUT_MS=1500
CLEAN_CORE_CONVERSATION_RETRIEVAL_ENABLED=true
CLEAN_CORE_CONTEXT_DEFAULT_MODE=balanced
CLEAN_CORE_CONTEXT_DEFAULT_RECENT_MESSAGE_LIMIT=20
CLEAN_CORE_CONTEXT_DEFAULT_RETRIEVAL_MAX_RESULTS=8
CLEAN_CORE_CONTEXT_DEFAULT_TASK_HISTORY_MAX_ITEMS=30
CLEAN_CORE_CONTEXT_DEFAULT_TOKEN_BUDGET=4000
CLEAN_CORE_CONTEXT_COMPRESSION_DEFAULT_ENABLED=true
CLEAN_CORE_CONTEXT_COMPRESSION_DEFAULT_MODE=truncate
